# ──────────────────────────────────────────────────────────
# WhatsApp Chatbot - Environment Configuration
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────

# Server Configuration
PORT=3000
NODE_ENV=development

# WhatsApp Cloud API (Meta)
# Get these from: https://developers.facebook.com/apps/
WHATSAPP_TOKEN=your_whatsapp_cloud_api_permanent_token
VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Groq AI (Free Tier)
# Get a FREE key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Email (Resend API — for auto-sending company brochures, bypasses Railway restrictions)
# Generate a free API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM_NAME=Aria | AI Assistant
# If you don't have a verified domain on Resend, you MUST use onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev
